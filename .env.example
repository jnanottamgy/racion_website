# Enquiry form delivery (Resend — https://resend.com).
# Without these the contact form reports that it isn't connected and shows
# RACEON's email and phone instead of silently dropping the enquiry.
RESEND_API_KEY=
# Verified sender on the Resend account, e.g. "RACEON <enquiries@raceon.in>"
ENQUIRY_FROM=
# Where enquiries land. Defaults to the address in src/lib/site.ts.
ENQUIRY_TO=

# Absolute base URL for canonical links, OG images and the sitemap.
# Falls back to the Vercel production hostname, then to https://raceon.in.
# Set this once the real domain is live.
NEXT_PUBLIC_SITE_URL=
